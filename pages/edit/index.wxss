.page {
  padding: 24rpx;
}

.section {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.07);
}

.section-title {
  margin-bottom: 14rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 900;
}

.field {
  display: flex;
  align-items: center;
  min-height: 82rpx;
  border-bottom: 1rpx solid #eef2f7;
}

.field:last-child {
  border-bottom: none;
}

.field text {
  width: 160rpx;
  color: #64748b;
  font-size: 25rpx;
  font-weight: 800;
}

.field input,
.picker-value {
  flex: 1;
  color: #111827;
  font-size: 27rpx;
  text-align: right;
}

.picker-field picker {
  flex: 1;
}

.two-col {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.field.stacked {
  display: block;
  min-height: auto;
  padding: 18rpx 0;
}

.field.stacked text {
  display: block;
  width: auto;
  margin-bottom: 10rpx;
}

.field.stacked input {
  box-sizing: border-box;
  width: 100%;
  height: 64rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  padding: 0 16rpx;
  text-align: left;
}

.save-btn {
  margin-top: 28rpx;
  border-radius: 20rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 88rpx;
}
